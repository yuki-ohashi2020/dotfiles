# ! ToDo ~/.local/binはパスが通っているため、シェルで叩けてしまう
# ! 本来はJustfileやBTTといったプログラムから呼び出すことを想定している
# ! そのため、 ~/.local/bin配下のスクリプトはパスが通っていない場所にいづれ移動させること
set dotenv-load
set fallback := true

# chezmoiにパスが通ってなければエラーで終了する
export SOURCE_DIR := `chezmoi source-path`
BIN_DIR := env_var("LOCAL_BIN_DIR")

default:
    @just --list

[private]
apply:
   chezmoi apply --verbose --interactive
   @# direnvが自動でリロードするので、sourceコマンドは不要

# 変更の詳細を表示
diff:
    @echo "dotfilesリポジトリとホームディレクトリの差分を表示します..."
    chezmoi status
    chezmoi diff

# 更新のDry-run
dry-run:
    chezmoi apply --dry-run --verbose

setup:
    echo "初期セットアップを実行します..."
    echo "実行対象のファイル一覧:"
    echo "- run_once_xxx"
    echo "- run_onchange_xxx"
    echo "- run_xxx"
    just apply

sync:
    @echo "dotfilesリポジトリに同期します..."
    @echo "From: $HOME => To: {{SOURCE_DIR}}"
    chezmoi add "$HOME/.zshenv"
    chezmoi add "$HOME/.editorconfig"
    chezmoi add -r "$HOME/.local/bin"
    chezmoi add -r "$HOME/.config/zsh"
    chezmoi add -r "$HOME/.config/git"
    chezmoi add -r "$HOME/.config/ghostty"
    chezmoi add -r "$HOME/.config/karabiner"
    chezmoi add -r "$HOME/.config/linearmouse"
    chezmoi add -r "$HOME/.config/nvim"
    chezmoi add -r "$HOME/.config/raycast"

deploy:
    @echo "dotfilesリポジトリを更新します..."
    @{{BIN_DIR}}/git/deploy.sh

upgrade:
    @echo "brewと管理パッケージを更新します..."
    brew update
    brew upgrade

nvim-upgrade:
    @echo "Neovimのパッケージをインストール/アップデート/クリーンアップします..."
    nvim --headless "+Lazy! sync" +qa

dump:
    @echo "管理パッケージをdumpします..."
    brew bundle dump --force --describe --file "$(SOURCE_DIR)/Brewfile"
