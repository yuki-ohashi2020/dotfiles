# chezmoiにパスが通ってなければエラーで終了する
export SOURCE_DIR := `chezmoi source-path`
export TARGET_DIR := `chezmoi target-path`
export LIB_DIR := "$TARGET_DIR/.local/libexec"

default:
    @just --list

[private]
apply:
   chezmoi apply --verbose --interactive
   @# direnvが自動でリロードするので、sourceコマンドは不要

[private]
chezmoi-add:
    chezmoi add "{{TARGET_DIR}}/.zshenv"
    chezmoi add "{{TARGET_DIR}}/.editorconfig"
    chezmoi add -r "{{TARGET_DIR}}/.config"
    chezmoi add -r "{{TARGET_DIR}}/.local/bin"
    chezmoi add -r "{{TARGET_DIR}}/.local/libexec"

[private]
git-auto-commit-push:
    @{{LIB_DIR}}/git/auto-commit-push.sh

# 変更の詳細を表示
diff:
    @echo "dotfilesリポジトリとホームディレクトリの差分を表示します..."
    chezmoi status
    chezmoi diff

# 更新のDry-run
dry-run:
    chezmoi apply --dry-run --verbose

setup:
    echo "初期セットアップを実行します..."
    echo "実行対象のファイル一覧:"
    echo "- run_once_xxx"
    echo "- run_onchange_xxx"
    echo "- run_xxx"
    just apply

save:
    @echo "------------------------------------------------"
    @echo "From: {{TARGET_DIR}} => To: {{SOURCE_DIR}}"
    @echo "------------------------------------------------"
    just chezmoi-add
    @echo "------------------------------------------------"
    @echo "Git Auto Commit Push"
    @echo "------------------------------------------------"
    just git-auto-commit-push

upgrade:
    @echo "brewと管理パッケージを更新します..."
    brew update
    brew upgrade

nvim-upgrade:
    @echo "Neovimのパッケージをインストール/アップデート/クリーンアップします..."
    nvim --headless "+Lazy! sync" +qa

dump:
    @echo "管理パッケージをdumpします..."
    brew bundle dump --force --describe --file "$(SOURCE_DIR)/Brewfile"
