# * 対話型シェル
#   - ユーザがターミナルを操作する時や対話型シェルで起動した時に読み込まれる
#
# ! 対象範囲
#   - プロンプトの外観
#   - hook処理
#   - エイリアスの設定
#   - 入力補完
#   - コマンド履歴の参照
#   - バインドキーの設定
#
# ! 運用ルール
#   - プラグインは事前に bash で Makefile にてインストールすること
#   - zshrc はプラグインが揃っている状態で起動すること
#   - そのため、プラグインのインストールチェックは zshrc で行わない
#   - 📢 setup 完了前の zsh の起動によるエラーは許容するものとする
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# local 変数
# ---------------------------------------------------------------------
DATA_BREW_PATH="$(brew --prefix)"/share             # プラグインの実体
ZSH_COMP_DUMP="${LOCAL_CACHE_PATH}/zsh/zcompdump"   #補完のキャッシュファイル

# ---------------------------------------------------------------------
# autoload
# ---------------------------------------------------------------------
autoload -Uz compinit           # 補完 有効化
mkdir -p "${ZSH_COMP_DUMP:h}"
compinit -d "$ZSH_COMP_DUMP"

autoload -Uz add-zsh-hook       # hook 有効化

# ---------------------------------------------------------------------
# 設定ファイル( *.zsh ) の読み込み
# ---------------------------------------------------------------------
zshrc_files=(
  theme.zsh         # 必ず最初に読み込むこと
  ls.zsh
  cd.zsh
  cli-editing.zsh
  completion.zsh
  highlight.zsh     # 必ず completion.zsh の後に読み込むこと
  history.zsh       # 必ず最後に読み込むこと
)

CONFIG_ZSHRC_PATH="$CONFIG_PATH"/zsh/zshrc
for file in "${zshrc_files[@]}"; do
  fullpath="$CONFIG_ZSHRC_PATH/$file"
  [[ -r "$fullpath" ]] && source "$fullpath"
done

# ---------------------------------------------------------------------
# エイリアス
# ---------------------------------------------------------------------
