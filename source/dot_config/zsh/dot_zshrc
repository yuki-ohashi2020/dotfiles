# TODO: 仕様が固まったらcd.envに移したい
fcd() {
    local fdir=(
        "$HOME/.config"
        "$HOME/.local"
    )

    local exclude_dirs=(
        "node_modules"
        ".git"
        "cache"
        "nvim/lazy"
        "vscode/extensions"
    )

    local ex_args=()
    for ex in "${exclude_dirs[@]}"; do
        ex_args+=(--exclude "$ex")
    done

    local selected
    # ポイント1: fdからはフルパスを出す
    # ポイント2: sedで表示用の列を作る（フルパス + タブ + チルダパス）
    # ポイント3: fzfの --with-nth で2列目（チルダ）だけを表示し、1列目（フルパス）を返す
    selected=$(fd -t d . "${fdir[@]}" "${ex_args[@]}" | sort | \
        awk -v home="$HOME" '{print $0 "\t" $0}' | \
        sed "s|\t$HOME|\t~|" | \
        fzf --delimiter=$'\t' --with-nth=2 | cut -d$'\t' -f1)

    if [ -n "$selected" ]; then
        # すでにフルパスなので、そのまま移動できる
        builtin cd "$selected"
    fi
}
