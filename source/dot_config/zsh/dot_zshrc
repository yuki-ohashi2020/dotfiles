
CACHE_PL_10K_FILE=$LOCAL_CACHE_PATH/p10k-instant-prompt-${(%):-%n}.zsh
[[ -r $CACHE_PL_10K_FILE ]] && source $CACHE_PL_10K_FILE

# powerlevel10k
DATA_PL_10K_DIR="$LOCAL_SHARE_PATH/powerlevel10k"
if [ ! -d "$DATA_PL_10K_DIR" ]; then
    # 最新のコミット分だけcloneする
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$DATA_PL_10K_DIR"
fi

# powerlevel10k プラグイン
source "$DATA_PL_10K_DIR/powerlevel10k.zsh-theme"
# powerlevel10k の設定
source "$CONFIG_PATH/zsh/.p10k.zsh"



autoload -Uz add-zsh-hook

alias cj="just -f $CHEZMOI_PATH/Justfile"
if [[ -n "$WARP_IS_TERMINAL" ]]; then
#  source ~/.config/shell/warp.env
#if [ -n "$WARP_IS_LOCAL_SHELL_SESSION" ]; then
fi


# .zshファイルをすべて読み込む
for file in ~/.config/zsh/*.zsh; do
    [ -f "$file" ] && source "$file"
done

