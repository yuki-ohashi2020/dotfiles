{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lockキー → Hyperキー(複合) / Escape(単体)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_option", "left_control"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyperキー+,/.→ F18キー(BTT起動)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "comma",
                                    "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
                                },
                                "to": [{ "key_code": "f18" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "period",
                                    "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
                                },
                                "to": [{ "key_code": "f18" }],
                                "type": "basic"
                            }
                        ]
                    },
