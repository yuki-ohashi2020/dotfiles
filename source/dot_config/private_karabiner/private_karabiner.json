                            {
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "select_input_source": { "language": "en" } },
                                    { "key_code": "left_shift" }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "スペースキー → 左Shiftキー(複合) / スペースキー(単体)",
