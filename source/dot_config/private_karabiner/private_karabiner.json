                                    "key_code": "spacebar",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_shift" }],
                                "to_if_alone": [{ "key_code": "spacebar" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode System: [Entry Logic] - 右コマンド単体押しによるモード有効化",
                        "manipulators": [
                            {
                                "description": "【Trigger】Right Command (Single Tap) Only",
                                "from": {
                                    "description": "他の修飾キー（ShiftやCtrl等）が押されていない、純粋な右Command単体押下を検知",
                                    "key_code": "right_command"
                                },
                                "to_if_alone": [
                                    {
                                        "description": "1. 内部変数 'normal_mode' を 1(ON) に設定し、他キーの挙動をVim化する準備をする",
                                        "set_variable": {
                                            "name": "normal_mode",
                                            "value": 1
                                        }
                                    },
                                    {
                                        "description": "2. Vimコマンドの誤発火を防ぐため、入力ソースを強制的に『英語(en)』に変更する",
                                        "select_input_source": { "language": "en" }
                                    },
                                    {
                                        "description": "3. 画面上に『NORMAL』と通知を出し、現在のモード状態を視覚的に明示する（認知負荷の低減）",
                                        "set_notification_message": {
                                            "id": "vim_mode_status",
                                            "text": "--- NORMAL ---"
                                        }
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim Mode System: [Exit Logic] - iキー単体押しによるNormalモード解除",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "description": "現在Normalモード（normal_mode = 1）である場合のみ、このルールを有効化する",
                                        "name": "normal_mode",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "description": "【Exit】Normalモード中に i を単体で押すと、Insertモード（通常状態）に戻る",
                                "from": {
                                    "description": "他の修飾キー（ShiftやCmd等）が押されていない、純粋な 'i' キーを検知",
                                    "key_code": "i"
                                },
                                "to_if_alone": [
                                    {
                                        "description": "1. 内部変数 'normal_mode' を 0(OFF) に戻し、通常のキー入力を復元する",
                                        "set_variable": {
                                            "name": "normal_mode",
                                            "value": 0
                                        }
                                    },
                                    {
                                        "description": "2. 画面上の『NORMAL』通知を消去し、通常モードに戻ったことを視覚的に示す",
                                        "set_notification_message": {
                                            "id": "vim_mode_status",
                                            "text": ""
                                        }
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
