{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.10.2",
  "schemes" : [
    {
      "buttons" : {
        "clickDebouncing" : {
          "timeout" : 50
        },
        "switchPrimaryButtonAndSecondaryButtons" : false,
        "universalBackForward" : false
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc548",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "pointer" : {
        "acceleration" : 2,
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : 0.06
      },
      "scrolling" : {
        "acceleration" : 1,
        "distance" : 3,
        "modifiers" : {
          "vertical" : {
            "command" : {
              "type" : "preventDefault"
            }
          }
        },
        "reverse" : {
          "vertical" : false
        },
        "speed" : 0
      }
    },
    {
      "buttons" : {
        "mappings" : [
          {
            "action" : {
              "run" : ""
            },
            "button" : 3,
            "command" : false,
            "control" : false,
            "option" : false,
            "shift" : false
          }
        ]
      },
      "if" : {
        "app" : "com.vivaldi.Vivaldi",
        "device" : {
          "category" : "mouse",
          "productID" : "0xc548",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "pointer" : {
        "speed" : 0.08
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0x27da",
          "productName" : "Karabiner DriverKit VirtualHIDPointing 1.8.0",
          "serialNumber" : "pqrs.org:Karabiner-DriverKit-VirtualHIDPointing",
          "vendorID" : "0x16c0"
        }
      },
      "pointer" : {
        "acceleration" : "unset",
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : "unset"
      }
    }
  ]
}