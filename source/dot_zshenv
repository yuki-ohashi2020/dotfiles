# * zsh特殊環境変数
#   - zshを起動した全てのシェルで最初に読み込まれる設定ファイル
#   - ログイン / 非ログイン、対話型 / 非対話型シェルを問わず読み込まれる
#   - ここで定義した環境変数はすべての zsh シェルで利用可能になる
#
# ! 対象範囲
#   - 全ての zsh シェルで必要な環境変数( PATH や言語など)の設定
#   - ログインシェル専用設定は zprofile に記述
#   - 対話型専用設定（プロンプト、補完、エイリアス等）は zshrc に記述
#
# ! 運用ルール
# - ユーザ定義環境変数を先にセットする
# - 必要に応じて zsh特殊環境変数を設定する

########################################################################
# 言語
########################################################################
export LANG=en_US.UTF-8


########################################################################
# エディッタ
########################################################################
export EDITOR=nvim
export VISUAL=nvim


########################################################################
# キャッシュ
########################################################################
LOCAL_CACHE_PATH="$HOME/.local/cache"
export XDG_CACHE_HOME="$LOCAL_CACHE_PATH"
# npmキャッシュ
export npm_config_cache="$LOCAL_CACHE_PATH/npm"
# lessコマンドのキャッシュファイル
export LESSHISTFILE="$LOCAL_CACHE_PATH/less/.lesshst"
# セッション履歴(.zsh_sessions)を作らない
export SHELL_SESSION_HISTORY=0


########################################################################
# config
########################################################################
CONFIG_PATH="$HOME/.config"
# zshのconfigディレクトリの指定
export ZDOTDIR="$CONFIG_PATH/zsh"


########################################################################
# Python
########################################################################
LOCAL_SHARE_PATH="$HOME/.local/share"
# pyenvの保存先(pyenv install)を指定
export PYENV_ROOT="$HOME/.local/share/pyenv"
export PYTHON_VERSION=3.12.2

########################################################################
# Path
########################################################################
LOCAL_BIN_PATH="$HOME/.local/bin"
BREW_PATH=/opt/homebrew/bin

# "$PYENV_ROOT/shims"

# path 配列を Unique (重複禁止) に設定
typeset -U path
# 配列としてパスを追加（$path を最後に書くことで既存のパスを維持）
path=(
    $LOCAL_BIN_PATH
    $BREW_PATH
    $path
)
